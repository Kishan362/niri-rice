layout {
    focus-ring {
        width 2
        active-gradient from="#74c7ec" to="#60afbe" angle=135
        inactive-color "#45475a"
    }

    border {
        off
        width 2
        active-color "#89dceb"
        inactive-color "#45475a"
        urgent-color "#f38ba8"
    }

    tab-indicator {
        active-color "#89dceb"
        inactive-color "#45475a"
        urgent-color "#f38ba8"
    }

    insert-hint {
        gradient from="#74c7ec80" to="#60afbe80" angle=135
    }
}

overview {
    backdrop-color "#11111b"
}
