layout {
    focus-ring {
        width 2
        active-gradient from="#eba0ac" to="#be607a" angle=135
        inactive-color "#45475a"
    }

    border {
        off
        width 2
        active-color "#f38ba8"
        inactive-color "#45475a"
        urgent-color "#f38ba8"
    }

    tab-indicator {
        active-color "#f38ba8"
        inactive-color "#45475a"
        urgent-color "#f38ba8"
    }

    insert-hint {
        gradient from="#eba0ac80" to="#be607a80" angle=135
    }
}

overview {
    backdrop-color "#11111b"
}
