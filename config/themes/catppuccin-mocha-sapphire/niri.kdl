layout {
    focus-ring {
        width 2
        active-gradient from="#89dceb" to="#60a1be" angle=135
        inactive-color "#45475a"
    }

    border {
        off
        width 2
        active-color "#74c7ec"
        inactive-color "#45475a"
        urgent-color "#f38ba8"
    }

    tab-indicator {
        active-color "#74c7ec"
        inactive-color "#45475a"
        urgent-color "#f38ba8"
    }

    insert-hint {
        gradient from="#89dceb80" to="#60a1be80" angle=135
    }
}

overview {
    backdrop-color "#11111b"
}
