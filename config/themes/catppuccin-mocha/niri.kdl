layout {
    focus-ring {
        width 2
        active-gradient from="#f5c2e7" to="#7c5fbf" angle=135
        inactive-color "#45475a"
    }

    border {
        off
        width 2
        active-color "#cba6f7"
        inactive-color "#45475a"
        urgent-color "#f38ba8"
    }

    tab-indicator {
        active-color "#cba6f7"
        inactive-color "#45475a"
        urgent-color "#f38ba8"
    }

    insert-hint {
        gradient from="#f5c2e780" to="#7c5fbf80" angle=135
    }
}

overview {
    backdrop-color "#11111b"
}
