* {
    bg:          #0b0a0ef2;
    bg-alt:      #16141a;
    bg-selected: #28131a;
    fg:          #f3f1f5;
    fg-muted:    #7c7684;
    crimson:     #e11d48;
    crimson-hi:  #ff2a55;
    border-col:  #e11d4866;

    background-color: transparent;
    text-color:       @fg;
    margin:           0px;
    padding:          0px;
    spacing:          0px;
}

window {
    location:         center;
    width:            560px;
    background-color: @bg;
    border:           1px solid;
    border-color:     @border-col;
    border-radius:    16px;
    padding:          14px;
}

mainbox {
    spacing:          12px;
    children:         [ inputbar, listview ];
}

inputbar {
    background-color: @bg-alt;
    border:           1px solid;
    border-color:     #2b2533;
    border-radius:    10px;
    padding:          10px 14px;
    spacing:          10px;
    children:         [ prompt, entry ];
}

prompt {
    text-color:       @crimson-hi;
    font:             "JetBrainsMono Nerd Font Bold 11";
}

entry {
    placeholder:      "Search...";
    placeholder-color: @fg-muted;
    text-color:       @fg;
    cursor:           text;
}

listview {
    lines:            8;
    columns:          1;
    fixed-height:     false;
    dynamic:          true;
    scrollbar:        false;
    spacing:          6px;
}

element {
    padding:          9px 12px;
    spacing:          12px;
    border-radius:    10px;
    background-color: transparent;
    text-color:       @fg;
    orientation:      horizontal;
    children:         [ element-icon, element-text ];
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:       #dcd8e0;
}

element selected.normal {
    background-color: @bg-selected;
    border:           1px solid;
    border-color:     @crimson;
    text-color:       #ffffff;
}

element-icon {
    size:             24px;
    vertical-align:   0.5;
}

element-text {
    vertical-align:   0.5;
    text-color:       inherit;
}
