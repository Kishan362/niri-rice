layout {
    focus-ring {
        width 2
        active-gradient from="#f2cdcd" to="#be6f60" angle=135
        inactive-color "#45475a"
    }

    border {
        off
        width 2
        active-color "#f5e0dc"
        inactive-color "#45475a"
        urgent-color "#f38ba8"
    }

    tab-indicator {
        active-color "#f5e0dc"
        inactive-color "#45475a"
        urgent-color "#f38ba8"
    }

    insert-hint {
        gradient from="#f2cdcd80" to="#be6f6080" angle=135
    }
}

overview {
    backdrop-color "#11111b"
}
