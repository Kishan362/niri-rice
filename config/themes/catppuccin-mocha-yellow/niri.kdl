layout {
    focus-ring {
        width 2
        active-gradient from="#fab387" to="#bea160" angle=135
        inactive-color "#45475a"
    }

    border {
        off
        width 2
        active-color "#f9e2af"
        inactive-color "#45475a"
        urgent-color "#f38ba8"
    }

    tab-indicator {
        active-color "#f9e2af"
        inactive-color "#45475a"
        urgent-color "#f38ba8"
    }

    insert-hint {
        gradient from="#fab38780" to="#bea16080" angle=135
    }
}

overview {
    backdrop-color "#11111b"
}
