layout {
    focus-ring {
        width 2
        active-gradient from="#b4befe" to="#6084be" angle=135
        inactive-color "#45475a"
    }

    border {
        off
        width 2
        active-color "#89b4fa"
        inactive-color "#45475a"
        urgent-color "#f38ba8"
    }

    tab-indicator {
        active-color "#89b4fa"
        inactive-color "#45475a"
        urgent-color "#f38ba8"
    }

    insert-hint {
        gradient from="#b4befe80" to="#6084be80" angle=135
    }
}

overview {
    backdrop-color "#11111b"
}
