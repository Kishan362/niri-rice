layout {
    focus-ring {
        width 2
        active-gradient from="#94e2d5" to="#67be60" angle=135
        inactive-color "#45475a"
    }

    border {
        off
        width 2
        active-color "#a6e3a1"
        inactive-color "#45475a"
        urgent-color "#f38ba8"
    }

    tab-indicator {
        active-color "#a6e3a1"
        inactive-color "#45475a"
        urgent-color "#f38ba8"
    }

    insert-hint {
        gradient from="#94e2d580" to="#67be6080" angle=135
    }
}

overview {
    backdrop-color "#11111b"
}
