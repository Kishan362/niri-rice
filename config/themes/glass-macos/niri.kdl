layout {
    focus-ring {
        width 2
        active-gradient from="#0a84ff" to="#0066d6" angle=135
        inactive-color "#d2d2d7"
    }

    border {
        off
        width 2
        active-color "#007aff"
        inactive-color "#d2d2d7"
        urgent-color "#ff3b30"
    }

    tab-indicator {
        active-color "#007aff"
        inactive-color "#d2d2d7"
        urgent-color "#ff3b30"
    }

    insert-hint {
        gradient from="#0a84ff80" to="#0066d680" angle=135
    }
}

overview {
    backdrop-color "#c7c7cc"
}
blur {
    passes 4
    offset 5
    noise 0.03
    saturation 1.2
}

layer-rule {
    match namespace="^waybar$"
    geometry-corner-radius 18
    background-effect {
        xray false
        blur true
    }
    popups {
        geometry-corner-radius 6
        background-effect {
            blur true
        }
    }
}

window-rule {
    match app-id="^kitty$"
    background-effect {
        blur true
    }
}
