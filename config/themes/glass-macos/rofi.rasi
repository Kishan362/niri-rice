* {
    bg:          #f5f5f7b3;
    bg-alt:      #ffffff59;
    bg-selected: #007aff;
    fg:          #1d1d1f;
    fg-muted:    #86868b;
    accent:      #007aff;
    accent-hi:   #0a84ff;
    border-col:  #007aff66;

    background-color: transparent;
    text-color:       @fg;
    margin:           0px;
    padding:          0px;
    spacing:          0px;
}

window {
    location:         center;
    width:            560px;
    background-color: @bg;
    border:           1px solid;
    border-color:     @border-col;
    border-radius:    16px;
    padding:          14px;
}

mainbox {
    spacing:          12px;
    children:         [ inputbar, listview ];
}

inputbar {
    background-color: @bg-alt;
    border:           1px solid;
    border-color:     #d2d2d7;
    border-radius:    10px;
    padding:          10px 14px;
    spacing:          10px;
    children:         [ prompt, entry ];
}

prompt {
    text-color:       @accent-hi;
    font:             "Noto Sans Bold 11";
}

entry {
    placeholder:      "Search...";
    placeholder-color: @fg-muted;
    text-color:       @fg;
    cursor:           text;
}

listview {
    lines:            8;
    columns:          1;
    fixed-height:     false;
    dynamic:          true;
    scrollbar:        false;
    spacing:          6px;
}

element {
    padding:          9px 12px;
    spacing:          12px;
    border-radius:    10px;
    background-color: transparent;
    text-color:       @fg;
    orientation:      horizontal;
    children:         [ element-icon, element-text ];
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:       #48484a;
}

element selected.normal {
    background-color: @bg-selected;
    border:           1px solid;
    border-color:     @accent;
    text-color:       #ffffff;
}

element-icon {
    size:             24px;
    vertical-align:   0.5;
}

element-text {
    vertical-align:   0.5;
    text-color:       inherit;
}
